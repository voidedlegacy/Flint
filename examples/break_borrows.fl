fn main() -> i64 {
	var a = 1
	let m = &mut a
	for {
		let k = m       // moves m...
		break           // ...and leaves the loop
	}
	let again = m       // error: m was moved inside the loop

	var b = 1
	let r = &b
	var i = 0
	for i < 3 {
		i = i + 1
		if i < 3 {
			b = 5           // error: continue goes back to the top, and r is read below
			continue
		}
		let peek = r
	}
	return 0
}
