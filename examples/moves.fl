fn main() {
	var a = 1
	var b = 2

	let x = a			// i64 is Copy: a still usable
	let y = a

	let m = &mut a
	let m2 = a  	// &mut is not Copy: a moves into m2
	let m3 = m  	// error: m was moved

	var r = &mut b
	let r2 = r 		// r moves into r2
	r = &mut b    // assigning makes r usable again
	let r3 = r    // ok

	let s = &m2   // ok: borrowing does not move
	let t = &m    // error: can't borrow m either, it was moved
	let u = r     // error: r moved into r3
}
