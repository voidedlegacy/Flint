fn main() {
	var a = 1
	var n = 0
	let m = &mut a
	for n < 3 {
		let k = m        // error: the first trip moves m, the second can't
		n = n + 1
	}

	var b = 1
	let r = &b
	for n < 6 {
		let peek = r     // r is read again at the top of every trip...
		b = b + 1        // error: ...so b is still borrowed here
		n = n + 1
	}

	var c = 1
	var w = &mut c
	for n < 9 {
		let k2 = w       // ok: w moves out...
		w = &mut c       // ...and gets a fresh value before the next trip
		n = n + 1
	}
	return 0
}
